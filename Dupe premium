-- INIT: Kiểm tra key cũ -> Loading -> Key hoặc Main
------------------------------------------------

task.spawn(function()
	-- Kiểm tra key đã lưu
	local savedValue
	local savedObj = game.CoreGui:FindFirstChild(KeyStorage)
	if savedObj then
		savedValue = savedObj.Value
	end
	
	if savedValue then
		local valid, decoded = IsKeyValid(savedValue)
		if valid then
			-- Có key hợp lệ -> chạy loading -> process
			Main.Visible = true
			StartProcess()
			return
		end
	end
	
	-- Không có key -> hiện key frame
	LoadingBG.Visible = false
	KeyFrame.Visible = true
end)

