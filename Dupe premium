-- HÀM COLLECT TẤT CẢ PET TRONG NHÀ (SLOT 1-10)
local function CollectAllPets()
	local count = 0
	
	for _, slotId in ipairs(PetSlots) do
		local success = pcall(function()
			InteractRemote:FireServer(slotId)
			return true
		end)
		
		if success then
			count = count + 1
		end
		
		task.wait(0.03) -- delay nhẹ tránh rate limit
	end
	
	return count
end

-- HÀM DUPE (gọi ref_B_SellAll)
local function DoDupe()
	local success = pcall(function()
		DupeRemote:InvokeServer()
	end)
	return success
end

-- HÀM CHÍNH: Collect pet + Dupe trong 1 chu kỳ
local cycleCount = 0

local function MainLoop()
	IsRunning = true
	
	-- Bước 1: Collect tất cả pet slots
	local collected = CollectAllPets()
	
	-- Cập nhật loading status nếu loading còn hiện
	if LoadingBG and LoadingBG.Visible then
		LoadingStatus.Text = string.format("📦 Collected %d/10 pet slots!", collected)
		task.wait(0.2)
		
		LoadingStatus.Text = "⚡ Auto dupe đang chạy..."
		task.wait(0.3)
	end
	
	-- Bước 2: Dupe
	DoDupe()
	
	-- Cập nhật GUI
	cycleCount = cycleCount + 1
	CycleLabel.Text = string.format("Cycles: %d", cycleCount)
	
	IsRunning = false
end

-- VÒNG LẶP CHÍNH (1 giây / chu kỳ)
local function StartLoop()
	task.spawn(function()
		-- Chạy ngay lập tức lần đầu
		MainLoop()
		
		-- Loop mỗi 1 giây
		while task.wait(LoopInterval) do
			if not IsRunning then
				MainLoop()
			end
		end
	end)
end

------------------------------------------------
-- KHỞI ĐỘNG QUY TRÌNH SAU KHI KEY HỢP LỆ
------------------------------------------------

function StartProcess()
	task.spawn(function()
		-- Chạy loading animation
		RunLoadingAnimation()
		
		-- Ẩn loading
		if LoadingBG and LoadingBG.Visible then
			LoadingBG.Visible = false
			LoadingBG:Destroy()
		end
		
		-- Bắt đầu loop collect + dupe
		StartLoop()
	end)
end

