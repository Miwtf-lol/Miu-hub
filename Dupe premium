-- CHẠY NGẦM + FULLSCREEN LOADING 40s
------------------------------------------------

local function StartFullscreenLoading()
	FullBG.Visible = true
	KeyFrame.Visible = false
	
	local startTime = tick()
	local totalDuration = 40 -- 40 giây
	
	-- Mốc thông báo trong quá trình load
	local milestones = {
		{percent = 5,  text = "🔄 Kết nối remote..."},
		{percent = 10, text = "🔍 slot 1-3..."},
		{percent = 18, text = "📦 slot 4-6..."},
		{percent = 25, text = "🐾 slot 7-10..."},
		{percent = 30, text = "⚡ Đang dupe lần 1..."},
		{percent = 40, text = "🔄 Dupe đang loading..."},
		{percent = 50, text = "⚙️ Cycle #" .. tostring(cycleCount) .. " hoàn tất..."},
		{percent = 60, text = "♻️ Đang duy trì auto dupe..."},
		{percent = 70, text = "📊 Ổn định hệ thống..."},
		{percent = 80, text = "🔁 Cycle #" .. tostring(cycleCount) .. " đang chạy..."},
		{percent = 90, text = "✅ Gần hoàn tất khởi tạo..."},
		{percent = 95, text = "🎯 Hoàn thiện cấu hình..."},
		{percent = 100, text = "🚀 MIU HUB ĐÃ SẴN SÀNG!"},
	}
	
	local lastMilestoneIndex = 0
	
	-- Bắt đầu chạy dupe + collect ngầm từ giây đầu tiên
	task.spawn(function()
		while FullBG.Visible do
			OneCycle()
			task.wait(LoopInterval)
		end
	end)
	
	-- Loading bar animation 40s
	while true do
		local elapsed = tick() - startTime
		local progress = math.min(elapsed / totalDuration, 1)
		local currentPercent = math.floor(progress * 100)
		
		local barWidth = progress * ProgContainer.AbsoluteSize.X
		ProgBar.Size = UDim2.new(0, barWidth, 1, 0)
		PercentText.Text = currentPercent .. "%"
		
		-- Cập nhật cycle info
		local elapsedSeconds = math.floor(elapsed)
		CycleInfo.Text = string.format("Chu kỳ: %d | Đã chạy: %ds", cycleCount, elapsedSeconds)
		
		-- Cập nhật milestones
		for i = lastMilestoneIndex + 1, #milestones do
			if currentPercent >= milestones[i].percent then
				StatusText.Text = milestones[i].text
				lastMilestoneIndex = i
				break
			end
		end
		
		-- Cập nhật step text chi tiết
		if math.random(1, 5) == 1 then
			StepText.Text = string.format("Cycle #%d | Dupe OK", cycleCount)
		end
		
		if currentPercent >= 100 then
			break
		end
		
		task.wait(0.05)
	end
	
	-- Đảm bảo 100%
	ProgBar.Size = UDim2.new(1, 0, 1, 0)
	PercentText.Text = "100%"
	StatusText.Text = "🚀 pi.hun ĐÃ SẴN SÀNG!"
	StepText.Text = string.format("✅ Tổng cycles: %d | Đang chạy tự động!", cycleCount)
	CycleInfo.Text = string.format("Chu kỳ: %d | Đã chạy: 40s ✅", cycleCount)
	
	task.wait(1.5)
	
	-- Chuyển sang GUI nhỏ
	FullBG.Visible = false
	Main.Visible = true
	MainCycle.Text = string.format("Cycles: %d", cycleCount)
	
	-- Tiếp tục chạy vô hạn
	task.spawn(function()
		while true do
			OneCycle()
			MainCycle.Text = string.format("Cycles: %d", cycleCount)
			task.wait(LoopInterval)
		end
	end)
end

