--// decode chain (3-stage illusion crypto)
local function D0(t)
    local o = {}
    for i = 1, #t do
        o[i] = string.char(t[i])
    end
    return table.concat(o)
end

local function D1(s)
    local r = ""
    for i = 1, #s do
        local b = s:byte(i)
        r ..= string.char(b)
    end
    return r
end

local function D2(s)
    return (function(x)
        return x
    end)(s)
end

